<div class="card shadow-sm">
  <div class="card-body">

    <%= form_with model: @schedule do |f| %>

      <% if @schedule.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">

            <% @schedule.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>

          </ul>
        </div>
      <% end %>

      <div class="mb-3">

        <%= f.label :title,
                    "タイトル",
                    class: "form-label" %>

        <span class="required">*</span>

        <%= f.text_field :title,
                         class: "form-control" %>

      </div>

      <div class="mb-3">

        <%= f.label :start_date,
                    "開始日",
                    class: "form-label" %>

        <span class="required">*</span>

        <%= f.date_field :start_date,
                         class: "form-control" %>

      </div>

      <div class="mb-3">

        <%= f.label :end_date,
                    "終了日",
                    class: "form-label" %>

        <span class="required">*</span>

        <%= f.date_field :end_date,
                         class: "form-control" %>

      </div>

      <div class="form-check mb-3">

        <%= f.check_box :all_day,
                        class: "form-check-input" %>

        <%= f.label :all_day,
                    "終日",
                    class: "form-check-label" %>

      </div>

      <div class="mb-3">

        <%= f.label :memo,
                    "スケジュールメモ",
                    class: "form-label" %>

        <%= f.text_area :memo,
                        class: "form-control" %>

      </div>

      <%= f.submit class: "btn btn-primary" %>

      <%= link_to "一覧へ戻る",
                  schedules_path,
                  class: "btn btn-secondary" %>

    <% end %>

  </div>
</div>
